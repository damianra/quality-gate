# quality-gate environment template — copy to .env and fill in values.
# .env is gitignored; never commit real secrets.

# --------------------------------------------------------------------------- #
# Required
# --------------------------------------------------------------------------- #

# Token used by the GitHub REST client (PRs, diffs, comments, commit
# statuses). Needs pull_requests:write + issues:write + repo:status
# (classic PAT) — or Commit statuses: write (fine-grained) — on the
# target repo so the FR-P8 quality-gate status can gate merges.
# Env-only by contract: it is never logged or passed as a CLI arg.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# --- GitHub App auth (FR-P18, recommended for production) ------------------- #
# When all three are set the service mints 1h installation tokens at run
# time instead of using the long-lived PAT above — comments/statuses are
# authored by the app bot and scoped to its permissions
# (contents:read + pull_requests/issues:write + statuses). Onboarding a
# repo is then just "install the app". Leave empty for the PAT path.
# The private key may be stored with literal \n escapes on one line.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# PR to review when running the orchestrator via compose or manually.
PR_NUMBER=123

# Host path of the repository under review; compose mounts it at /work.
# The mount is read-write because tsc/node --check may write caches.
REPO_UNDER_TEST=./target-repo

# --------------------------------------------------------------------------- #
# Orchestrator
# --------------------------------------------------------------------------- #

# Postgres credentials for the compose stack (FR-P24). Consumed by the
# postgres service itself and interpolated into the services' internal
# DATABASE_URL — compose fails fast when unset. Change BEFORE first
# deploy: these are baked into the pgdata volume at init.
POSTGRES_USER=qualitygate
# URL-safe chars only: the password is interpolated into a DSN — avoid
# @ : / % or percent-encode them.
POSTGRES_PASSWORD=change-me-to-a-real-password
POSTGRES_DB=qualitygate

# Postgres DSN for langgraph-checkpoint-postgres. Enables resuming a review
# when the PR gets new commits. Optional locally: unset -> in-memory saver.
# Host-local runs point at localhost:5432 and MUST keep user/password in
# sync with the POSTGRES_* vars; the compose services get the internal
# postgres:5432 URL composed from those vars automatically.
DATABASE_URL=postgresql://qualitygate:change-me-to-a-real-password@localhost:5432/qualitygate

# Filesystem path of the repo under review inside the orchestrator container.
REPO_PATH=/work

# true -> run the full graph but skip post_verdict (no comment published).
DRY_RUN=false

# Seconds between SIGTERM and SIGKILL when the cleanup node reaps pgids.
QG_CLEANUP_GRACE_SECONDS=3

# Wall-clock timeout per QA validation process (tsc --noEmit, node --check,
# python compile() check, go vet, cargo check).
QG_QA_PROCESS_TIMEOUT=120

# File extensions that activate the QA specialist (FR-L1). Comma or space
# separated, leading dot optional. Docs/config/data files never trigger QA.
QG_QA_CODE_EXTS=.ts,.tsx,.js,.jsx,.mjs,.cjs,.py,.go,.rs,.java,.kt,.rb,.php,.cs,.swift,.c,.cc,.cpp,.h,.hpp

# Cap on file-list pages fetched while profiling a PR (30 files/page).
QG_MAX_FILES_PAGES=5

# Blast-radius scope: reviewers and sub-agents only see the diff, changed
# files and their direct dependents — never the whole repo. These hard
# caps bound token spend and review time.
QG_SCOPE_MAX_FILES=25
QG_SCOPE_MAX_CHARS=200000

# Specialist LLM prompt evidence (FR-O23/FR-C*): per-section char caps
# so the prompt fits the deployed model context. The diff keeps
# priority; full contents of changed files fill the remaining budget.
QG_PROMPT_MAX_DIFF_CHARS=16000
QG_PROMPT_MAX_FILES_CHARS=12000
QG_PROMPT_MAX_BODY_CHARS=4000      # FR-C1: ## PR body section
QG_PROMPT_MAX_AGENTS_CHARS=4000    # FR-C2: ## Repo rules (AGENTS.md)
QG_RELATED_HEAD_FILES=5            # FR-C3: dependents with head excerpt
QG_RELATED_HEAD_CHARS=1500         # FR-C3: chars per dependent head
QG_CHECKLIST_MAX_ITEMS=12          # FR-C9: inspection items per role

# Dependency audit (FR-O24): when the diff touches a manifest/lockfile,
# SecurityAgent runs a vuln scanner (osv-scanner > npm audit > pip-audit)
# over the worktree. QG_DEP_AUDIT=0 disables it entirely.
QG_DEP_AUDIT=1
QG_AUDIT_PROCESS_TIMEOUT=120

# --------------------------------------------------------------------------- #
# MCP server
# --------------------------------------------------------------------------- #

# Override only for GitHub Enterprise.
GITHUB_API_URL=https://api.github.com

# Subprocess timeouts (seconds).
QG_PROCESS_TIMEOUT=120
QG_GIT_TIMEOUT=60
QG_RG_TIMEOUT=30
QG_HTTP_TIMEOUT=30

# Grace period for killing a spawned process group on timeout.
QG_KILL_GRACE_SECONDS=3

# Retries on transient faults (FR-P3): GitHub REST calls and the
# ephemeral clone retry 429/5xx/network errors with exponential
# backoff, honoring Retry-After. Permanent 4xx/auth, timeouts and
# worktree-size-cap failures never retry.
QG_RETRY_ATTEMPTS=3
QG_RETRY_BACKOFF_S=2

# Vibecoding scanner thresholds.
QG_LARGE_DIFF_FILES=10
QG_LARGE_DIFF_LINES=600
QG_COMMENTED_BLOCK_MIN=3
QG_WHITESPACE_RATIO_THRESHOLD=0.6

# Log level for the SSE server started by compose.
QG_LOG_LEVEL=INFO

# --------------------------------------------------------------------------- #
# Service mode (webhook ingress) — FR-O19..O22. Only needed when running the
# deployed review service; ignored by the CLI/Action path.
# --------------------------------------------------------------------------- #

# HMAC secret GitHub signs webhook payloads with (Settings -> Webhooks).
# REQUIRED in service mode: unset -> every payload rejected (INV-6).
GITHUB_WEBHOOK_SECRET=

# Repos the service may review — comma-separated "owner/repo" or "owner/*".
# Empty = deny all (deny-by-default). Wildcard "*" allows any repo the
# token can read — NOT recommended on a public port.
QG_ALLOWED_REPOS=your-org/your-repo

# Interface the ingress binds: loopback on bare host; compose overrides
# to 0.0.0.0 so nginx reaches it on the internal network only.
QG_INGRESS_HOST=127.0.0.1

# Bare host: backend bind port (nginx proxies to it).
# Compose: loopback port nginx publishes for local tunnels/debugging —
# production TLS lives on caddy :443 (see QG_PUBLIC_HOST below).
QG_INGRESS_PORT=8089

# Public hostname for the TLS endpoint (FR-P10). Required when running
# the caddy `tls` profile — it terminates HTTPS for the webhook:
#   docker compose --profile tls up -d
# GitHub webhook URL: https://<QG_PUBLIC_HOST>/github/webhook
# Leave unset for local tunnel testing (docs/local-webhook-setup.md).
QG_PUBLIC_HOST=

# Parent dir for ephemeral PR worktrees (qg-* dirs, removed after each run).
QG_WORKTREE_ROOT=/tmp

# Allow validators that EXECUTE PR-controlled code: `cargo check` runs
# build.rs/proc-macros, `go vet` may build cgo (FR-P12). Untrusted
# service-mode checkouts keep this off (compose default 0); CLI/Action
# runs on operator-chosen checkouts default to 1.
QG_EXEC_VALIDATORS=0

# Commit-status context posted on the PR head sha (FR-P8). Require this
# check in branch protection ("require status checks before merging")
# so the verdict actually blocks merges — pending while running,
# success/failure/error on finish.
QG_STATUS_CONTEXT=quality-gate

# Timeout (s) per git step of the ephemeral clone.
QG_CLONE_TIMEOUT=300

# Disk cap per worktree in bytes (oversized clones are removed + dropped).
QG_MAX_WORKTREE_BYTES=2147483648

# Max review runs in parallel across distinct PR threads.
QG_MAX_CONCURRENT_RUNS=2

# Graceful shutdown (FR-P5): seconds the worker waits for in-flight
# runs before cancelling their drains.
QG_SHUTDOWN_GRACE_S=120

# Observability (FR-P15/P16). The ingress logs one JSON object per
# record at QG_LOG_LEVEL, correlated by run_id (pr-review/{repo}/{pr}).
# GET /readyz reports Postgres reachability + queue depth for
# monitoring; QG_HEARTBEAT_URL is a dead-man ping (e.g. healthchecks.io)
# hit after every completed run — silence pages the team.
QG_HEARTBEAT_URL=

# --------------------------------------------------------------------------- #
# LLM deployment profiles (FR-P19) — per-role configs (FR-O15).
#
# Three supported profiles, selected per role via QG_LLM_PROVIDER:
#   deterministic — all QG_LLM_PROVIDER* unset: zero LLM calls. The
#                   baseline for CPU-only hosts and for code that must
#                   not leave the perimeter.
#   api           — role-scoped API providers (openai | anthropic |
#                   nvidia | openrouter | custom | devin-cli). The
#                   recommended profile on CPU-only hosts when code
#                   egress is allowed: ~10–11k input tokens per
#                   specialist call, ~$0.01–0.20/review by model tier.
#   local         — ollama. Only where the host has a GPU or where
#                   multi-minute per-call latency is acceptable. On
#                   CPU-only hosts it is NOT viable for interactive
#                   review: 8B-class reasoning yields ~3–8 min/call ->
#                   timeouts against QG_LLM_TIMEOUT and degraded findings.
#
# Every QG_LLM_<SETTING> accepts a role suffix QG_LLM_<SETTING>_<ROLE> with
# ROLE ∈ {HARNESS, REVIEW, SECURITY, QA}. A suffixed var overrides the base
# var for that role only; the base block doubles as the HARNESS config and
# the shared fallback. Empty suffixed vars are ignored.
# (see llm.py PROVIDERS for per-provider defaults).
# --------------------------------------------------------------------------- #

# FR-T5: each role is an ISOLATED stateless session — its own provider,
# model, system prompt and bounded context; calls never share state.
# Deployment default: deterministic — uncomment ONE profile below.

# --- Profile: deterministic (default; nothing to set) ----------------------
#QG_LLM_PROVIDER=

# --- Profile: api (CPU-only hosts with allowed egress) ---------------------
# Pick ONE provider block and uncomment it. Every block is complete:
# provider + model + key + JSON mode + budget knobs. The key can live in
# QG_LLM_API_KEY or the provider's canonical var (shown per block);
# QG_LLM_MODEL may be omitted to use the provider's default (noted).
# Per-role overrides (QG_LLM_*_<ROLE>) can mix providers — e.g. cheap
# harness on OpenRouter, security on Anthropic (see below).

# ··········································································
# Anthropic (Claude) — native Messages API.
# https://console.anthropic.com -> API keys. Default model:
# claude-sonnet-4-5-20250929.
#QG_LLM_PROVIDER=anthropic
#QG_LLM_MODEL=claude-haiku-4-5           # or claude-sonnet-4-5-20250929
#ANTHROPIC_API_KEY=sk-ant-...           # canonical var; or QG_LLM_API_KEY
#QG_LLM_JSON_MODE=1
#QG_LLM_TIMEOUT=120
#QG_LLM_MAX_TOKENS=8000

# ··········································································
# OpenAI — chat completions. Default model: gpt-4o-mini.
#QG_LLM_PROVIDER=openai
#QG_LLM_MODEL=gpt-4o-mini               # or a larger tier for security
#OPENAI_API_KEY=sk-...                  # canonical var; or QG_LLM_API_KEY
#QG_LLM_JSON_MODE=1
#QG_LLM_TIMEOUT=120
#QG_LLM_MAX_TOKENS=8000

# ··········································································
# OpenRouter — one key reaches any hosted model id (provider/model).
# Default model: meta-llama/llama-3.3-70b-instruct.
#QG_LLM_PROVIDER=openrouter
#QG_LLM_MODEL=anthropic/claude-haiku-4.5
#   other ids: openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct,
#   qwen/qwen3-32b — any model listed at openrouter.ai/models
#OPENROUTER_API_KEY=sk-or-...           # canonical var; or QG_LLM_API_KEY
#QG_LLM_JSON_MODE=1
#QG_LLM_TIMEOUT=120
#QG_LLM_MAX_TOKENS=8000

# ··········································································
# NVIDIA NIM — hosted open models. Default: meta/llama-3.3-70b-instruct.
#QG_LLM_PROVIDER=nvidia
#QG_LLM_MODEL=meta/llama-3.3-70b-instruct
#NVIDIA_API_KEY=nvapi-...               # canonical var; or QG_LLM_API_KEY
#QG_LLM_JSON_MODE=1
#QG_LLM_TIMEOUT=120
#QG_LLM_MAX_TOKENS=8000

# ··········································································
# Custom — any OpenAI-compatible endpoint: LiteLLM proxy, Azure OpenAI,
# corporate gateway. QG_LLM_BASE_URL is REQUIRED (no provider default).
#QG_LLM_PROVIDER=custom
#QG_LLM_BASE_URL=https://your-gateway.example.com/v1
#QG_LLM_MODEL=your-deployment-name
#QG_LLM_API_KEY=                        # no canonical fallback for custom
#QG_LLM_JSON_MODE=1
#QG_LLM_TIMEOUT=120
#QG_LLM_MAX_TOKENS=8000

# devin-cli (bare host only — images do not ship the CLI): see the
# per-role section below; auth lives in `devin auth`, not env keys.

# --- Profile: local (GPU host or non-interactive latency only) -------------
#QG_LLM_PROVIDER=ollama
#QG_LLM_MODEL=qwen3:8b
# larger ctx: ollama defaults num_ctx=4096 and truncates longer prompts;
# create a derived model (docs/local-webhook-setup.md §context window):
#   printf 'FROM qwen3:8b\nPARAMETER num_ctx 8192\n' | ollama create qwen3:8b-8k -f -
#QG_LLM_MODEL=qwen3:8b-8k
#QG_LLM_BASE_URL=                # defaults per provider; required for "custom"
#QG_LLM_TEMPERATURE=0.0
#QG_LLM_TIMEOUT=300              # 8B reasoning on CPU needs minutes, not s
#QG_LLM_MAX_TOKENS=20000

# --- Per-role overrides (optional) ------------------------------------------
#QG_LLM_PROVIDER_REVIEW=
#QG_LLM_MODEL_REVIEW=
#QG_LLM_JSON_MODE_REVIEW=1       # reasoning models ignore the JSON contract
#QG_LLM_TIMEOUT_REVIEW=300
#QG_LLM_PROVIDER_SECURITY=
#QG_LLM_MODEL_SECURITY=
#QG_LLM_JSON_MODE_SECURITY=1
#QG_LLM_PROVIDER_QA=
#QG_LLM_MODEL_QA=
#QG_LLM_JSON_MODE_QA=1

# Alternative role setups (uncomment to mix providers per role):
# - review on devin-cli: QG_LLM_PROVIDER_REVIEW=devin-cli +
#   QG_LLM_MODEL_REVIEW=swe-2-high (auth lives in `devin auth`; container
#   images do NOT ship the CLI — bare host only)
# - external specialists: QG_LLM_PROVIDER_<ROLE>=openrouter +
#   QG_LLM_API_KEY_<ROLE> or canonical OPENROUTER_API_KEY

# Per-role generation overrides are supported too, e.g. QG_LLM_MAX_TOKENS_QA,
# QG_LLM_TEMPERATURE_SECURITY, QG_LLM_TIMEOUT_REVIEW, QG_LLM_BASE_URL_HARNESS,
# QG_LLM_JSON_MODE_SECURITY=1  # sends response_format:{type:json_object} —
# needed when a role runs on a reasoning/local model that ignores the
# JSON output contract (e.g. qwen3 via Ollama).
# Canonical key vars remain the last fallback per provider: OPENAI_API_KEY,
# ANTHROPIC_API_KEY, NVIDIA_API_KEY, OPENROUTER_API_KEY.
