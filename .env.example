# quality-gate environment template — copy to .env and fill in values.
# .env is gitignored; never commit real secrets.

# --------------------------------------------------------------------------- #
# Required
# --------------------------------------------------------------------------- #

# Token used by the GitHub REST client (PRs, diffs, comments). Needs
# pull_requests:write + issues:write on the target repo. Env-only by contract:
# it is never logged or passed as a CLI arg.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# PR to review when running the orchestrator via compose or manually.
PR_NUMBER=123

# Host path of the repository under review; compose mounts it at /work.
# The mount is read-write because tsc/node --check may write caches.
REPO_UNDER_TEST=./target-repo

# --------------------------------------------------------------------------- #
# Orchestrator
# --------------------------------------------------------------------------- #

# Postgres DSN for langgraph-checkpoint-postgres. Enables resuming a review
# when the PR gets new commits. Optional locally: unset -> in-memory saver.
# (compose.yaml already injects the internal service URL.)
DATABASE_URL=postgresql://qualitygate:qualitygate@localhost:5432/qualitygate

# Filesystem path of the repo under review inside the orchestrator container.
REPO_PATH=/work

# true -> run the full graph but skip post_verdict (no comment published).
DRY_RUN=false

# Seconds between SIGTERM and SIGKILL when the cleanup node reaps pgids.
QG_CLEANUP_GRACE_SECONDS=3

# Wall-clock timeout per QA validation process (tsc --noEmit, node --check).
QG_QA_PROCESS_TIMEOUT=120

# Cap on file-list pages fetched while profiling a PR (30 files/page).
QG_MAX_FILES_PAGES=5

# Blast-radius scope: reviewers and sub-agents only see the diff, changed
# files and their direct dependents — never the whole repo. These hard
# caps bound token spend and review time.
QG_SCOPE_MAX_FILES=25
QG_SCOPE_MAX_CHARS=200000

# --------------------------------------------------------------------------- #
# MCP server
# --------------------------------------------------------------------------- #

# Override only for GitHub Enterprise.
GITHUB_API_URL=https://api.github.com

# Subprocess timeouts (seconds).
QG_PROCESS_TIMEOUT=120
QG_GIT_TIMEOUT=60
QG_RG_TIMEOUT=30
QG_HTTP_TIMEOUT=30

# Grace period for killing a spawned process group on timeout.
QG_KILL_GRACE_SECONDS=3

# Vibecoding scanner thresholds.
QG_LARGE_DIFF_FILES=10
QG_LARGE_DIFF_LINES=600
QG_COMMENTED_BLOCK_MIN=3
QG_WHITESPACE_RATIO_THRESHOLD=0.6

# Log level for the SSE server started by compose.
QG_LOG_LEVEL=INFO

# --------------------------------------------------------------------------- #
# LLM provider (optional) — enables LLM-backed specialist enrichment
# --------------------------------------------------------------------------- #

# One of: ollama | openai | anthropic | nvidia | openrouter | custom.
# Leave unset to keep the fully deterministic review (no LLM calls).
#QG_LLM_PROVIDER=ollama

# Model name; each provider has a default (see llm.py PROVIDERS).
#QG_LLM_MODEL=qwen2.5-coder:7b

# API key — env-only, never committed. Not needed for ollama.
# Canonical vars are honored as fallback: OPENAI_API_KEY, ANTHROPIC_API_KEY,
# NVIDIA_API_KEY, OPENROUTER_API_KEY.
#QG_LLM_API_KEY=

# Base URL override. Defaults: ollama → http://localhost:11434/v1,
# nvidia → https://integrate.api.nvidia.com/v1,
# openrouter → https://openrouter.ai/api/v1. Required for "custom".
#QG_LLM_BASE_URL=

# Generation settings.
#QG_LLM_TEMPERATURE=0.0
#QG_LLM_TIMEOUT=60
#QG_LLM_MAX_TOKENS=2048
