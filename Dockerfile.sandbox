# qg-sandbox — FR-O28 execution image for sandboxed validation.
# Runs PR-controlled code (validators, audits, functional steps);
# never the orchestrator itself. Non-root by default; the runtime adds
# --network none / --read-only / resource caps per the FR-O28 contract.
FROM python:3.12-slim

RUN pip install --no-cache-dir uv pip-audit \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       nodejs npm git ripgrep ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 qg

USER qg
WORKDIR /src
